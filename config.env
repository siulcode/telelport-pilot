# Single source of truth. Every script sources this file.
# Local overrides go in config.env.local (uncommitted, sourced second).

# --- Project / AWS -----------------------------------------------------------
PROJECT_NAME="teleport-k8s"
AWS_REGION="us-east-1"
STACK_NAME="${PROJECT_NAME}"

# --- Instances ---------------------------------------------------------------
CP_INSTANCE_TYPE="t3.medium"    # kubeadm preflight needs 2 vCPU + ~1700MB free
WORKER_INSTANCE_TYPE="t3.small"
ROOT_VOLUME_SIZE="30"           # GB. 8GB default fills up -> DiskPressure

# --- Network -----------------------------------------------------------------
VPC_CIDR="10.0.0.0/16"
SUBNET_CIDR="10.0.1.0/24"

CP_PRIVATE_IP="10.0.1.10"       # static, so certSANs stay valid across rebuilds
WORKER1_PRIVATE_IP="10.0.1.21"
WORKER2_PRIVATE_IP="10.0.1.22"

CP_HOSTNAME="cp01"              # set via UserData; kubeadm uses these as node names
WORKER1_HOSTNAME="worker01"
WORKER2_HOSTNAME="worker02"

CP_ENDPOINT="k8s-api.internal"  # split-horizon: private IP in-VPC, EIP from laptop
APP_NAMESPACE="demo"          # namespace the app and its users live in
SITE_HOSTNAME="nginx.demo"      # CN on the cert Traefik serves
PUBLIC_INGRESS_CIDR="127.0.0.1/32"  # widen only for a public ACME HTTP-01 challenge

# --- Kubernetes --------------------------------------------------------------
# Version lives in one place; the per-minor repo path and apt pin are derived.
K8S_VERSION="v1.36.3"
K8S_PKG_REVISION="1.1"
_semver="${K8S_VERSION#v}"
K8S_MINOR="v${_semver%.*}"                    # v1.36  -- apt repo path
K8S_PATCH="${_semver}-${K8S_PKG_REVISION}"    # 1.36.3-1.1 -- apt pin
unset _semver

POD_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"
KUBE_PROXY_MODE="iptables"      # iptables | ipvs (ipvs needs the ip_vs modules)

CNI="cilium"                    # cilium | calico
CILIUM_VERSION=""               # empty = CLI picks stable; pin once confirmed
CALICO_VERSION="v3.30.0"

# --- Local paths -------------------------------------------------------------
SSH_KEY_DIR="./.ssh"
SSH_KEY_PATH="${SSH_KEY_DIR}/${PROJECT_NAME}.pem"
SSH_USER="ubuntu"
KUBECONFIG_LOCAL="./.kube/config"
BUILD_DIR="./.build"
LOG_DIR="${BUILD_DIR}/logs"
