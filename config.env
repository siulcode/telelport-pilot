# ============================================================================
# Single source of truth. Every script sources this file.
# Change values here, nowhere else.
# ============================================================================

# --- Project / AWS -----------------------------------------------------------
PROJECT_NAME="teleport-k8s"
AWS_REGION="us-east-1"
STACK_NAME="${PROJECT_NAME}"

# --- Instance sizing ---------------------------------------------------------
# kubeadm preflight requires ~1700MB free RAM and 2 CPUs on the control plane.
# t3.micro (1GB) will fail. t3.medium/t3.small is the cheapest working shape.
CP_INSTANCE_TYPE="t3.medium"
WORKER_INSTANCE_TYPE="t3.small"
ROOT_VOLUME_SIZE="30"          # GB. 8GB default fills with images -> DiskPressure.

# --- Network -----------------------------------------------------------------
VPC_CIDR="10.0.0.0/16"
SUBNET_CIDR="10.0.1.0/24"

# Static private IPs make certSANs and /etc/hosts deterministic across rebuilds.
CP_PRIVATE_IP="10.0.1.10"
WORKER1_PRIVATE_IP="10.0.1.21"
WORKER2_PRIVATE_IP="10.0.1.22"

# Hostnames (set via UserData, used by kubeadm as node names)
CP_HOSTNAME="cp01"
WORKER1_HOSTNAME="worker01"
WORKER2_HOSTNAME="worker02"

# Split-horizon API endpoint. Resolves to the private IP inside the VPC and to
# the Elastic IP from your laptop. One cert, both paths. See README.
CP_ENDPOINT="k8s-api.internal"

# Opens 80/443 to the world for a future ACME HTTP-01 challenge.
# Leave closed by default; widen to 0.0.0.0/0 only if you go the public-DNS route.
PUBLIC_INGRESS_CIDR="127.0.0.1/32"

# --- Kubernetes --------------------------------------------------------------
K8S_MINOR="v1.36"              # pkgs.k8s.io repo is per-minor
K8S_PATCH="1.36.3-1.1"         # apt package version string
K8S_VERSION="v1.36.3"          # kubeadm ClusterConfiguration
POD_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"
CNI="cilium"                   # cilium | calico

# --- Local paths -------------------------------------------------------------
SSH_KEY_DIR="./.ssh"
SSH_KEY_PATH="${SSH_KEY_DIR}/${PROJECT_NAME}.pem"
SSH_USER="ubuntu"
KUBECONFIG_LOCAL="./.kube/config"
